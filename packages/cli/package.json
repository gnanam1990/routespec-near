  },
  "devDependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "0.1.26",
    "@routespec/client-adapter": "workspace:*",
    "@routespec/kernel": "workspace:*",
    "@routespec/regressions": "workspace:*"
  }
