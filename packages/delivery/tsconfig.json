{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": [
    "src/**/*.ts",
    "e2e/**/*.ts",
    "test/**/*.ts",
    "runtime-test/**/*.ts",
    "../../examples/third-party/**/*.ts"
  ]
}
