{
  "name": "routespec",
  "version": "0.0.0",
  "private": true,
  "description": "RouteSpec: local-first deterministic reliability release check for NEAR Intents 1Click clients.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p apps/console/tsconfig.json --noEmit",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secret-scan": "node scripts/secret-scan.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run secret-scan",
    "test:e2e": "pnpm --filter @routespec/console e2e",
    "build:console": "pnpm --filter @routespec/console build",
    "test:e2e:real": "pnpm --filter @routespec/console e2e:real"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.18.12",
    "eslint": "9.39.1",
    "fast-check": "4.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "3.2.4"
  }
}
