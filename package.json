{
  "name": "routespec",
  "version": "0.0.0",
  "private": true,
  "description": "RouteSpec: local-first deterministic reliability release check for NEAR Intents 1Click clients.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p apps/console/tsconfig.json --noEmit && tsc -p packages/security-suite/tsconfig.json --noEmit && tsc -p packages/delivery/tsconfig.json --noEmit",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secret-scan": "node scripts/secret-scan.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run secret-scan",
    "test:e2e": "pnpm --filter @routespec/console e2e",
    "build:console": "pnpm --filter @routespec/console build",
    "test:e2e:real": "pnpm --filter @routespec/console e2e:real",
    "audit:supply-chain": "node --no-warnings packages/hardening/src/audit-cli.ts",
    "test:delivery": "vitest run -c vitest.delivery.config.ts",
    "test:containment": "vitest run -c vitest.containment.config.ts",
    "test:third-party": "vitest run -c vitest.third-party.config.ts",
    "delivery:journey": "node --no-warnings packages/delivery/src/journey.ts",
    "examples:fetch": "node --no-warnings examples/third-party/support/fetch.ts",
    "examples:third-party": "node --no-warnings packages/delivery/src/third-party.ts",
    "test:registry": "vitest run -c vitest.registry.config.ts",
    "registry:build": "node scripts/registry/build.mjs",
    "registry:test": "cargo test --locked --manifest-path contracts/routespec-registry/Cargo.toml -p routespec-certificate",
    "registry:reproduce": "node scripts/registry/reproduce.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.18.12",
    "eslint": "9.39.1",
    "fast-check": "4.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": "11.0.3",
      "minimatch@11.0.3>brace-expansion": "5.0.12",
      "minimatch@11.0.3>@isaacs/nonrecursive-glob-match": "1.0.3"
    }
  }
}
