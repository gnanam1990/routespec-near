  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@routespec/control-api": "workspace:*",
    "@routespec/scenario": "workspace:*",
    "@routespec/store": "workspace:*",
    "@types/react": "18.3.31",
